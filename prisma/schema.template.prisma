generator client {
  provider = "prisma-client-js"
  @@PREVIEW_FEATURES@@
}

// Provider is resolved from env (DB_CONNECTION or PRISMA_PROVIDER) with sqlite fallback
// via scripts/prepare-prisma-schema.js
// Supported providers: postgresql, mysql, sqlite

datasource db {
  provider = "@@PROVIDER@@"
}


model Tag {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  color          String    @default("#000000")
  createdAt      DateTime  @default(now())
  usageCount     Int       @default(0)
  
  notes          Note[]
  diagrams       Diagram[]
  
  @@index([slug])
}

model Diagram {
  id           String    @id
  title        String
  emoji        String
  description  String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  isFavorite   Boolean   @default(false)
  totalVersions Int      @default(1)
  searchVector String    @default("")
  contents     Content[]
  tags         Tag[]

  @@index([updatedAt], map: "diagram_updatedAt_idx")
  @@DIAGRAM_INDEX@@
}

model Content {
  id        String   @id
  diagramId String
  content   String
  updatedAt DateTime
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId, updatedAt], map: "content_diagram_updated_idx")
}

model Setting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id           String   @id
  title        String
  content      String
  language     String   @default("txt")
  emoji        String   @default("")
  starred      Boolean  @default(false)
  private      Boolean  @default(false)
  searchVector String   @default("")
  hasTodos     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  tags         Tag[]

  @@index([updatedAt], map: "note_updatedAt_idx")
  @@index([hasTodos], map: "note_hasTodos_idx")
  @@NOTE_INDEX@@
  @@index([starred], map: "note_starred_idx")
}

